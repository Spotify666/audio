{
  "name": "waveprint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Makes a voice note whose waveform draws a letter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "assets": "node scripts/gen-assets.mjs",
    "single": "node scripts/build-singlefile.mjs",
    "font": "node scripts/preview-font.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "opus-recorder": "^8.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
